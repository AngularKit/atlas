{
  "name": "@angularkit/atlas",
  "version": "0.0.0-development",
  "description": "Evidence-backed static inventory of Angular routes for audits and AI agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "angular-atlas": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-template-parser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "quality": "pnpm run typecheck && pnpm test && pnpm run test:package",
    "prepack": "pnpm run build",
    "test:browser": "pnpm run build && node --test test/browser/*.test.mjs",
    "benchmark:viewer": "pnpm run build && node scripts/benchmark-viewer.mjs",
    "test:package:pnpm": "node scripts/test-package.mjs --pnpm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AngularKit/atlas.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "angular",
    "router",
    "audit",
    "static-analysis",
    "ai-agents"
  ],
  "devDependencies": {
    "@angular/compiler": "22.0.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.4.2 <6.1"
  },
  "packageManager": "pnpm@10.34.6"
}
